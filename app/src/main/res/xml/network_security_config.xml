<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. Audiobookshelf self-hosters frequently terminate TLS on a reverse
  proxy with a private CA, which is handled by TOFU certificate pinning in
  TlsFactory.kt rather than by blanket-trusting the user CA store.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
